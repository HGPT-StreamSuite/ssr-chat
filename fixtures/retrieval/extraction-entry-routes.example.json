{
  "schema_version": "1.0.1",
  "routing": "explicit_or_planner_v1",
  "targets": {
    "/game": "/retrieve/game-knowledge",
    "/channel": "/answer/channel-knowledge",
    "/history": "/answer/chat-history",
    "/transcript": "/answer/stt-transcript"
  },
  "query_extraction": {
    "schema_version": "1.0.1",
    "routes": {
      "/game": {
        "rule": "registered_gameplay_records_v1",
        "entities": [{"id": "synthetic-aurora", "name": "Aurora Blade"}, {"id": "synthetic-echo", "name": "Echo Blade"}]
      },
      "/channel": {
        "rule": "registered_channel_announcement_v1",
        "entities": [{"id": "synthetic-launch", "name": "launch"}]
      }
    }
  }
}
